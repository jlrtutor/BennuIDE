{
  "name": "bennugd2-fpg-editor",
  "displayName": "BennuGD2 FPG Sprite Collection Editor",
  "description": "Visual editor and manager for BennuGD / BennuGD2 .fpg sprite collection files.",
  "version": "1.0.0",
  "publisher": "bennuide",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "bennugd2.fpgEditor",
        "displayName": "BennuGD FPG Sprite Editor",
        "selector": [
          {
            "filenamePattern": "*.fpg"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "bennugd2.newFpg",
        "title": "BennuGD2: Create New Empty FPG File",
        "category": "BennuGD2"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
