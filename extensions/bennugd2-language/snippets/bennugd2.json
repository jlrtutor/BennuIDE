{
  "Program Skeleton": {
    "prefix": "program",
    "body": [
      "import \"libmod_gfx\";",
      "import \"libmod_input\";",
      "import \"libmod_misc\";",
      "import \"libmod_sound\";",
      "",
      "program ${1:MyGame};",
      "global",
      "    ${2:int score = 0;}",
      "end",
      "",
      "begin",
      "    set_mode(${3:800}, ${4:600});",
      "    set_fps(${5:60}, 0);",
      "    window_set_title(\"${6:My BennuGD2 Game}\");",
      "",
      "    ${7:// Start actors or processes}",
      "",
      "    while (!key(_esc))",
      "        frame;",
      "    end",
      "",
      "    let_me_alone();",
      "    exit();",
      "end"
    ],
    "description": "Create a full BennuGD2 Program skeleton with imports and game loop"
  },
  "Process Definition": {
    "prefix": "process",
    "body": [
      "process ${1:MyProcess}(${2:x, y})",
      "private",
      "    ${3:int speed = 4;}",
      "end",
      "",
      "begin",
      "    graph = ${4:1};",
      "    loop",
      "        ${5:// Process logic}",
      "        frame;",
      "    end",
      "end"
    ],
    "description": "Create a BennuGD2 Process definition"
  },
  "Player Process with Movement": {
    "prefix": "proc_player",
    "body": [
      "process Player(x, y)",
      "private",
      "    int speed = ${1:5};",
      "    int cooldown = 0;",
      "end",
      "begin",
      "    graph = ${2:1};",
      "    loop",
      "        // 4-Way Movement",
      "        if (key(_left) && x > ${3:20}) x -= speed; flags = 1; end",
      "        if (key(_right) && x < ${4:780}) x += speed; flags = 0; end",
      "        if (key(_up) && y > ${5:20}) y -= speed; end",
      "        if (key(_down) && y < ${6:580}) y += speed; end",
      "",
      "        // Action / Shoot",
      "        if (key(_space) && cooldown <= 0)",
      "            ${7:Bullet(x, y - 20);}",
      "            cooldown = ${8:10};",
      "        end",
      "        if (cooldown > 0) cooldown--; end",
      "",
      "        frame;",
      "    end",
      "end"
    ],
    "description": "Player actor process with 4-way keyboard controls and shoot action"
  },
  "Enemy Actor Process": {
    "prefix": "proc_enemy",
    "body": [
      "process Enemy(x, y)",
      "private",
      "    int speed = ${1:3};",
      "    int hit_id;",
      "end",
      "begin",
      "    graph = ${2:2};",
      "    loop",
      "        y += speed;",
      "        if (y > ${3:650}) return; end",
      "",
      "        hit_id = collision(type ${4:Bullet});",
      "        if (hit_id)",
      "            signal(hit_id, s_kill);",
      "            ${5:score += 100;}",
      "            return;",
      "        end",
      "",
      "        frame;",
      "    end",
      "end"
    ],
    "description": "Enemy actor with movement and collision detection"
  },
  "Enemy Spawner Timer": {
    "prefix": "spawner",
    "body": [
      "process Spawner()",
      "private",
      "    int timer = 0;",
      "end",
      "begin",
      "    loop",
      "        if (timer <= 0)",
      "            ${1:Enemy(rand(40, 760), -20);}",
      "            timer = rand(${2:20}, ${3:60});",
      "        else",
      "            timer--;",
      "        end",
      "        frame;",
      "    end",
      "end"
    ],
    "description": "Periodic entity spawner process"
  },
  "State Machine Loop": {
    "prefix": "statemachine",
    "body": [
      "const",
      "    STATE_MENU     = 1;",
      "    STATE_GAME     = 2;",
      "    STATE_GAMEOVER = 3;",
      "end",
      "",
      "global",
      "    int current_state = STATE_MENU;",
      "end",
      "",
      "// Inside main loop",
      "while (!key(_esc) || current_state != STATE_MENU)",
      "    switch (current_state)",
      "        case STATE_MENU:",
      "            ${1:SceneMenu();}",
      "        end",
      "        case STATE_GAME:",
      "            ${2:SceneGame();}",
      "        end",
      "        case STATE_GAMEOVER:",
      "            ${3:SceneGameOver();}",
      "        end",
      "    end",
      "    frame;",
      "end"
    ],
    "description": "Game scene state machine structure"
  },
  "2D Camera Scroll Initialization": {
    "prefix": "scroll_init",
    "body": [
      "// Start 2D horizontal/vertical scroll",
      "scroll_start(${1:0}, ${2:file_fpg}, ${3:graph_background}, ${4:graph_foreground}, ${5:0}, ${6:0});",
      "scroll[${1:0}].camera = ${7:player_id};",
      "scroll[${1:0}].ratio = ${8:200};"
    ],
    "description": "Initialize BennuGD 2D scroll viewport"
  },
  "HUD Score Display": {
    "prefix": "hud_score",
    "body": [
      "write(0, ${1:20}, ${2:20}, ALIGN_TOP_LEFT, \"${3:Puntuación:}\");",
      "write_var(0, ${1:20} + ${4:100}, ${2:20}, ALIGN_TOP_LEFT, &${5:score});"
    ],
    "description": "Render text and auto-updating variable on screen"
  },
  "Sprite Animation Loop": {
    "prefix": "fpg_anim",
    "body": [
      "// Cycle through animation frames",
      "graph++;",
      "if (graph > ${1:last_frame})",
      "    graph = ${2:first_frame};",
      "end"
    ],
    "description": "Cycle through sprite animation sequence"
  },
  "Function Definition": {
    "prefix": "function",
    "body": [
      "function ${1:int} ${2:calculate}(${3:int a, int b})",
      "private",
      "    ${4:// Private variables}",
      "end",
      "",
      "begin",
      "    ${5:return a + b;}",
      "end"
    ],
    "description": "Create a BennuGD2 Function definition"
  },
  "Struct Definition": {
    "prefix": "struct",
    "body": [
      "struct ${1:TEntity}",
      "    int id;",
      "    int x;",
      "    int y;",
      "    int health;",
      "end"
    ],
    "description": "Create a struct definition"
  },
  "While Loop": {
    "prefix": "while",
    "body": [
      "while (${1:condition})",
      "    ${2:// body}",
      "    frame;",
      "end"
    ],
    "description": "While loop"
  },
  "For Loop": {
    "prefix": "for",
    "body": [
      "for (${1:i} = ${2:0}; ${1:i} < ${3:10}; ${1:i}++)",
      "    ${4:// body}",
      "end"
    ],
    "description": "For loop"
  },
  "Repeat Loop": {
    "prefix": "repeat",
    "body": [
      "repeat",
      "    ${1:// body}",
      "    frame;",
      "until (${2:condition});"
    ],
    "description": "Repeat until loop"
  },
  "Switch Statement": {
    "prefix": "switch",
    "body": [
      "switch (${1:expression})",
      "    case ${2:1}:",
      "        ${3:// case 1}",
      "    end",
      "    default:",
      "        ${4:// default}",
      "    end",
      "end"
    ],
    "description": "Switch statement"
  },
  "Global Block": {
    "prefix": "global",
    "body": [
      "global",
      "    ${1:// Global variables}",
      "end"
    ],
    "description": "Global declaration block"
  },
  "Local Block": {
    "prefix": "local",
    "body": [
      "local",
      "    ${1:// Local variables added to all processes}",
      "end"
    ],
    "description": "Local declaration block"
  },
  "Private Block": {
    "prefix": "private",
    "body": [
      "private",
      "    ${1:// Private variables}",
      "end"
    ],
    "description": "Private declaration block"
  },
  "Constant Block": {
    "prefix": "const",
    "body": [
      "const",
      "    ${1:MAX_ENEMIES} = ${2:50};",
      "end"
    ],
    "description": "Constants declaration block"
  }
}
