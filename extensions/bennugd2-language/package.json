{
  "name": "bennugd2-language",
  "displayName": "BennuGD2 Language Support & Tools",
  "description": "Official BennuGD2 language support, LSP, interactive debugger, compilation tools, and themes for BennuIDE.",
  "version": "1.0.0",
  "publisher": "vscode",
  "license": "MIT",
  "engines": {
    "vscode": "*"
  },
  "categories": [
    "Programming Languages",
    "Themes",
    "Snippets",
    "Debuggers",
    "Linters"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:bennugd2",
    "onCommand:bennugd2.compile",
    "onCommand:bennugd2.run",
    "onCommand:bennugd2.compileAndRun",
    "*"
  ],
  "contributes": {
    "languages": [
      {
        "id": "bennugd2",
        "aliases": [
          "BennuGD2",
          "BennuGD",
          "Bennu",
          "bennugd2",
          "bennugd",
          "bgd",
          "PRG",
          "prg"
        ],
        "extensions": [
          ".prg",
          ".inc",
          ".bgd",
          ".PRG",
          ".INC",
          ".BGD"
        ],
        "firstLine": "^(?:\\s*(?://|/\\*|#)|\\b(?:[pP][rR][oO][gG][rR][aA][mM]|[pP][rR][oO][cC][eE][sS][sS]|[fF][uU][nN][cC][tT][iI][oO][nN]|[iI][mM][pP][oO][rR][tT]|[iI][nN][cC][lL][uU][dD][eE]|[gG][lL][oO][bB][aA][lL]|[lL][oO][cC][aA][lL]|[pP][rR][iI][vV][aA][tT][eE]|[pP][uU][bB][lL][iI][cC])\\b)",
        "configuration": "./language-configuration.json"
      }
    ],
    "configurationDefaults": {
      "workbench.iconTheme": "bennuide-icons",
      "workbench.editor.languageDetection": false,
      "files.associations": {
        "*.prg": "bennugd2",
        "*.PRG": "bennugd2",
        "*.inc": "bennugd2",
        "*.INC": "bennugd2",
        "*.bgd": "bennugd2",
        "*.BGD": "bennugd2"
      }
    },
    "grammars": [
      {
        "language": "bennugd2",
        "scopeName": "source.bennugd2",
        "path": "./syntaxes/bennugd2.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "bennuide-icons",
        "label": "BennuIDE (Tema de Iconos Oficial)",
        "path": "./icons/bennuide-icon-theme.json"
      }
    ],
    "themes": [
      {
        "label": "BennuIDE Dark (One Dark Pro)",
        "uiTheme": "vs-dark",
        "path": "./themes/bennuide-dark.json"
      },
      {
        "label": "BennuIDE Light (PowerShell ISE)",
        "uiTheme": "vs",
        "path": "./themes/bennuide-light.json"
      }
    ],
    "snippets": [
      {
        "language": "bennugd2",
        "path": "./snippets/bennugd2.json"
      }
    ],
    "commands": [
      {
        "command": "bennugd.compile",
        "title": "BennuGD: Compilar Archivo/Proyecto",
        "category": "BennuGD",
        "icon": "$(gear)"
      },
      {
        "command": "bennugd.compileAndRun",
        "title": "BennuGD: Compilar y Ejecutar",
        "category": "BennuGD",
        "icon": "$(run)"
      },
      {
        "command": "bennugd.run",
        "title": "BennuGD: Ejecutar (.dcb)",
        "category": "BennuGD",
        "icon": "$(play)"
      },
      {
        "command": "bennugd.clean",
        "title": "BennuGD: Limpiar Binarios (.dcb)",
        "category": "BennuGD",
        "icon": "$(trash)"
      },
      {
        "command": "bennugd.switchVersion",
        "title": "BennuGD: Cambiar Versión Activa del Compilador (v1 / v2)",
        "category": "BennuGD",
        "icon": "$(tools)"
      },
      {
        "command": "bennugd.showReferences",
        "title": "BennuGD: Mostrar Referencias",
        "category": "BennuGD"
      },
      {
        "command": "bennugd2.compile",
        "title": "BennuGD: Compilar Archivo/Proyecto",
        "category": "BennuGD"
      },
      {
        "command": "bennugd2.compileAndRun",
        "title": "BennuGD: Compilar y Ejecutar",
        "category": "BennuGD"
      },
      {
        "command": "bennugd2.run",
        "title": "BennuGD: Ejecutar (.dcb)",
        "category": "BennuGD"
      },
      {
        "command": "bennugd2.clean",
        "title": "BennuGD: Limpiar Binarios (.dcb)",
        "category": "BennuGD"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "bennugd.compileAndRun",
          "when": "resourceExtname == .prg || resourceExtname == .PRG || resourceExtname == .inc || resourceExtname == .INC || editorLangId == bennugd2",
          "group": "navigation@1"
        },
        {
          "command": "bennugd.compile",
          "when": "resourceExtname == .prg || resourceExtname == .PRG || resourceExtname == .inc || resourceExtname == .INC || editorLangId == bennugd2",
          "group": "navigation@2"
        },
        {
          "command": "bennugd.switchVersion",
          "when": "resourceExtname == .prg || resourceExtname == .PRG || resourceExtname == .inc || resourceExtname == .INC || editorLangId == bennugd2",
          "group": "navigation@3"
        }
      ],
      "editor/title/run": [
        {
          "command": "bennugd.compileAndRun",
          "when": "resourceExtname == .prg || resourceExtname == .PRG || editorLangId == bennugd2",
          "group": "navigation@1"
        },
        {
          "command": "bennugd.compile",
          "when": "resourceExtname == .prg || resourceExtname == .PRG || editorLangId == bennugd2",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "bennugd.compile"
        },
        {
          "command": "bennugd.compileAndRun"
        },
        {
          "command": "bennugd.run"
        },
        {
          "command": "bennugd.clean"
        },
        {
          "command": "bennugd.switchVersion"
        }
      ]
    },
    "breakpoints": [
      {
        "language": "bennugd2"
      }
    ],
    "debuggers": [
      {
        "type": "bennugd2",
        "label": "BennuGD2 Debugger",
        "languages": [
          "bennugd2"
        ],
        "configurationSnippets": [
          {
            "label": "BennuGD2: Launch Game",
            "description": "Compile with debug symbols and run with BennuGD2 Debugger",
            "body": {
              "type": "bennugd2",
              "request": "launch",
              "name": "Debug BennuGD2 Game",
              "program": "^\"\\${workspaceFolder}/main.prg\"",
              "stopOnEntry": false
            }
          }
        ]
      }
    ],
    "configuration": {
      "type": "object",
      "title": "BennuGD Studio",
      "properties": {
        "bennugd.version": {
          "type": "string",
          "enum": [
            "v2",
            "v1"
          ],
          "enumDescriptions": [
            "BennuGD versión 2 (bgdc / bgd2)",
            "BennuGD versión 1 clásico (bgdc v1)"
          ],
          "default": "v2",
          "description": "Versión activa del compilador y motor BennuGD para este proyecto o espacio de trabajo."
        },
        "bennugd.mainFile": {
          "type": "string",
          "default": "",
          "description": "Archivo .prg principal del proyecto. Si está vacío, se compilará el archivo .prg abierto actualmente."
        },
        "bennugd.killPreviousOnRun": {
          "type": "boolean",
          "default": true,
          "description": "Finalizar automáticamente cualquier instancia del juego en ejecución antes de compilar y ejecutar una nueva."
        },
        "bennugd.clearOutputBeforeCompile": {
          "type": "boolean",
          "default": true,
          "description": "Limpiar la consola de salida de BennuGD antes de cada compilación."
        },
        "bennugd.v2.compilerPath": {
          "type": "string",
          "default": "bgdc",
          "description": "[BennuGD v2] Ruta o nombre del ejecutable del compilador bgdc/bgd2 para BennuGD 2."
        },
        "bennugd.v2.runtimePath": {
          "type": "string",
          "default": "bgdi",
          "description": "[BennuGD v2] Ruta o nombre del ejecutable del intérprete/runtime bgdi/bgd2 para BennuGD 2."
        },
        "bennugd.v2.compilerArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "[BennuGD v2] Argumentos adicionales de línea de comandos pasados a bgdc v2."
        },
        "bennugd.v2.runtimeArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "[BennuGD v2] Argumentos adicionales de línea de comandos pasados a bgdi v2."
        },
        "bennugd.v2.includePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "[BennuGD v2] Rutas adicionales de búsqueda de includes/módulos (-i)."
        },
        "bennugd.v1.compilerPath": {
          "type": "string",
          "default": "bgdc",
          "description": "[BennuGD v1] Ruta o nombre del ejecutable del compilador bgdc de BennuGD 1 clásico."
        },
        "bennugd.v1.runtimePath": {
          "type": "string",
          "default": "bgdi",
          "description": "[BennuGD v1] Ruta o nombre del ejecutable del intérprete/runtime bgdi de BennuGD 1 clásico."
        },
        "bennugd.v1.compilerArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "[BennuGD v1] Argumentos adicionales de línea de comandos pasados a bgdc v1."
        },
        "bennugd.v1.runtimeArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "[BennuGD v1] Argumentos adicionales de línea de comandos pasados a bgdi v1."
        },
        "bennugd.v1.includePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "[BennuGD v1] Rutas adicionales de búsqueda de includes/módulos (-i)."
        },
        "bennugd.debugPort": {
          "type": "number",
          "default": 4711,
          "description": "Puerto TCP para la conexión con el depurador interactivo."
        }
      }
    },
    "problemMatchers": [
      {
        "name": "bennugd-bgdc",
        "owner": "bennugd",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": [
          {
            "regexp": "^(.+?):(\\d+):\\s*(error|warning)?:\\s*(.+)$",
            "file": 1,
            "line": 2,
            "severity": 3,
            "message": 4
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node && esbuild src/server/server.ts --bundle --outfile=out/server/server.js --external:vscode --format=cjs --platform=node",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "dependencies": {
    "@vscode/debugadapter": "^1.68.0",
    "@vscode/debugprotocol": "^1.68.0",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
