{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "BennuGD2",
  "scopeName": "source.bennugd2",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#preprocessor"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#process-control"
    },
    {
      "include": "#control-flow"
    },
    {
      "include": "#storage-types"
    },
    {
      "include": "#builtin-constants"
    },
    {
      "include": "#process-variables"
    },
    {
      "include": "#builtin-functions"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#function-call"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.bennugd2",
          "match": "//.*$"
        },
        {
          "name": "comment.line.semicolon.bennugd2",
          "match": ";.*$"
        },
        {
          "name": "comment.block.bennugd2",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "meta.preprocessor.bennugd2",
          "match": "^\\s*(#\\s*(?:[dD][eE][fF][iI][nN][eE]|[uU][nN][dD][eE][fF]|[iI][fF][dD][eE][fF]|[iI][fF][nN][dD][eE][fF]|[eE][lL][sS][eE]|[eE][nN][dD][iI][fF]|[iI][fF]|[pP][rR][aA][gG][mM][aA]|[iI][nN][cC][lL][uU][dD][eE]|[eE][mM][bB][eE][dD]_[fF][iI][lL][eE]|[dD][eE][cC][oO][dD][eE]_[uU][tT][fF]8_[sS][tT][rR][iI][nN][gG][sS]|[nN][oO]_[dD][eE][cC][oO][dD][eE]_[uU][tT][fF]8_[sS][tT][rR][iI][nN][gG][sS]))\\b",
          "captures": {
            "1": {
              "name": "keyword.control.directive.bennugd2"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.bennugd2",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.bennugd2",
              "match": "\\\\(?:[nrtvbf\"\\']|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4})"
            }
          ]
        },
        {
          "name": "string.quoted.single.bennugd2",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.bennugd2",
              "match": "\\\\(?:[nrtvbf\"\\']|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4})"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.bennugd2",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.bennugd2",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.float.bennugd2",
          "match": "\\b[0-9]+\\.[0-9]+(?:[eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.decimal.bennugd2",
          "match": "\\b[0-9]+(?:[eE][+-]?[0-9]+)?\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "keyword.declaration.process.bennugd2",
          "match": "\\b([pP][rR][oO][gG][rR][aA][mM]|[pP][rR][oO][cC][eE][sS][sS]|[fF][uU][nN][cC][tT][iI][oO][nN]|[dD][eE][cC][lL][aA][rR][eE]|[iI][mM][pP][oO][rR][tT]|[iI][nN][cC][lL][uU][dD][eE]|[eE][mM][bB][eE][dD]_[fF][iI][lL][eE])\\b"
        },
        {
          "name": "keyword.declaration.scope.bennugd2",
          "match": "\\b([gG][lL][oO][bB][aA][lL]|[lL][oO][cC][aA][lL]|[pP][rR][iI][vV][aA][tT][eE]|[pP][uU][bB][lL][iI][cC]|[cC][oO][nN][sS][tT]|[tT][yY][pP][eE]|[sS][tT][rR][uU][cC][tT]|[dD][uU][pP]|[pP][oO][iI][nN][tT][eE][rR])\\b"
        },
        {
          "name": "keyword.control.block.bennugd2",
          "match": "\\b([bB][eE][gG][iI][nN]|[eE][nN][dD])\\b"
        }
      ]
    },
    "process-control": {
      "patterns": [
        {
          "name": "keyword.control.process.bennugd2",
          "match": "\\b([fF][rR][aA][mM][eE]|[sS][iI][gG][nN][aA][lL]|[cC][lL][oO][nN][eE]|[kK][iI][lL][lL]|[sS][lL][eE][eE][pP]|[wW][aA][kK][eE][uU][pP]|[fF][rR][eE][eE][zZ][eE]|[uU][nN][fF][rR][eE][eE][zZ][eE]|[lL][eE][tT]_[mM][eE]_[aA][lL][oO][nN][eE]|[eE][xX][iI][tT]_[pP][rR][oO][cC][eE][sS][sS]|[yY][iI][eE][lL][dD])\\b"
        }
      ]
    },
    "control-flow": {
      "patterns": [
        {
          "name": "keyword.control.conditional.bennugd2",
          "match": "\\b([iI][fF]|[eE][lL][sS][eE]|[eE][lL][sS][eE][iI][fF]|[eE][lL][sS][iI][fF]|[eE][lL][iI][fF]|[sS][wW][iI][tT][cC][hH]|[cC][aA][sS][eE]|[dD][eE][fF][aA][uU][lL][tT])\\b"
        },
        {
          "name": "keyword.control.loop.bennugd2",
          "match": "\\b([wW][hH][iI][lL][eE]|[lL][oO][oO][pP]|[rR][eE][pP][eE][aA][tT]|[uU][nN][tT][iI][lL]|[fF][oO][rR]|[fF][rR][oO][mM]|[tT][oO]|[sS][tT][eE][pP])\\b"
        },
        {
          "name": "keyword.control.flow.bennugd2",
          "match": "\\b([bB][rR][eE][aA][kK]|[cC][oO][nN][tT][iI][nN][uU][eE]|[rR][eE][tT][uU][rR][nN]|[gG][oO][tT][oO]|[jJ][mM][pP]|[cC][aA][lL][lL]|[oO][nN][eE][xX][iI][tT]|[oO][nN][eE][rR][rR][oO][rR]|[oO][nN]|[eE][xX][iI][tT]|[eE][rR][rR][oO][rR]|[rR][eE][sS][uU][mM][eE]|[nN][eE][xX][tT])\\b"
        }
      ]
    },
    "storage-types": {
      "patterns": [
        {
          "name": "storage.type.bennugd2",
          "match": "\\b([iI][nN][tT]|[iI][nN][tT]8|[iI][nN][tT]16|[iI][nN][tT]32|[iI][nN][tT]64|[uU][iI][nN][tT]|[uU][iI][nN][tT]8|[uU][iI][nN][tT]16|[uU][iI][nN][tT]32|[uU][iI][nN][tT]64|[bB][yY][tT][eE]|[wW][oO][rR][dD]|[dD][wW][oO][rR][dD]|[qQ][wW][oO][rR][dD]|[sS][hH][oO][rR][tT]|[lL][oO][nN][gG]|[sS][bB][yY][tT][eE]|[cC][hH][aA][rR]|[sS][tT][rR][iI][nN][gG]|[fF][lL][oO][aA][tT]|[dD][oO][uU][bB][lL][eE]|[bB][oO][oO][lL]|[bB][oO][oO][lL][eE][aA][nN]|[sS][iI][gG][nN][eE][dD]|[uU][nN][sS][iI][gG][nN][eE][dD]|[vV][oO][iI][dD])\\b"
        }
      ]
    },
    "builtin-constants": {
      "patterns": [
        {
          "name": "constant.language.bennugd2",
          "match": "\\b([tT][rR][uU][eE]|[fF][aA][lL][sS][eE]|[nN][uU][lL][lL]|[nN][iI][lL]|[uU][nN][dD][eE][fF][iI][nN][eE][dD]|[mM][oO][uU][sS][eE])\\b"
        },
        {
          "name": "constant.other.signal.bennugd2",
          "match": "\\b([sS]_[kK][iI][lL][lL]|[sS]_[wW][aA][kK][eE][uU][pP]|[sS]_[sS][lL][eE][eE][pP]|[sS]_[fF][rR][eE][eE][zZ][eE]|[sS]_[uU][nN][fF][rR][eE][eE][zZ][eE]|[sS]_[kK][iI][lL][lL]_[tT][rR][eE][eE]|[sS]_[wW][aA][kK][eE][uU][pP]_[tT][rR][eE][eE]|[sS]_[sS][lL][eE][eE][pP]_[tT][rR][eE][eE]|[sS]_[fF][rR][eE][eE][zZ][eE]_[tT][rR][eE][eE]|[sS]_[uU][nN][fF][rR][eE][eE][zZ][eE]_[tT][rR][eE][eE])\\b"
        },
        {
          "name": "constant.other.enum.bennugd2",
          "match": "\\b([gG]_[wW][iI][dD][tT][hH]|[gG]_[hH][eE][iI][gG][hH][tT]|[gG]_[cC][eE][nN][tT][eE][rR]_[xX]|[gG]_[cC][eE][nN][tT][eE][rR]_[yY]|[gG]_[xX]_[cC][eE][nN][tT][eE][rR]|[gG]_[yY]_[cC][eE][nN][tT][eE][rR]|[gG]_[pP][iI][tT][cC][hH]|[gG]_[dD][eE][pP][tT][hH]|[bB]_[cC][lL][eE][aA][rR]|[qQ]_[nN][eE][aA][rR][eE][sS][tT]|[qQ]_[lL][iI][nN][eE][aA][rR]|[qQ]_[bB][eE][sS][tT]|[qQ]_[mM][iI][pP][mM][aA][pP]|[cC][hH][aA][rR][sS][eE][tT]_[iI][sS][oO]8859|[cC][hH][aA][rR][sS][eE][tT]_[cC][pP]850|[nN][fF][bB]_[vV][aA][rR][iI][aA][bB][lL][eE][wW][iI][dD][tT][hH]|[nN][fF][bB]_[fF][iI][xX][eE][dD][wW][iI][dD][tT][hH]|[aA][lL][lL]_[tT][eE][xX][tT]|[aA][lL][iI][gG][nN]_[tT][oO][pP]_[lL][eE][fF][tT]|[aA][lL][iI][gG][nN]_[tT][oO][pP]|[aA][lL][iI][gG][nN]_[tT][oO][pP]_[rR][iI][gG][hH][tT]|[aA][lL][iI][gG][nN]_[cC][eE][nN][tT][eE][rR]_[lL][eE][fF][tT]|[aA][lL][iI][gG][nN]_[cC][eE][nN][tT][eE][rR]|[aA][lL][iI][gG][nN]_[cC][eE][nN][tT][eE][rR]_[rR][iI][gG][hH][tT]|[aA][lL][iI][gG][nN]_[bB][oO][tT][tT][oO][mM]_[lL][eE][fF][tT]|[aA][lL][iI][gG][nN]_[bB][oO][tT][tT][oO][mM]|[aA][lL][iI][gG][nN]_[bB][oO][tT][tT][oO][mM]_[rR][iI][gG][hH][tT]|[pP][fF]_[dD][iI][aA][gG]|[pP][fF]_[mM][aA][nN][hH][aA][tT][tT][aA][nN]|[pP][fF]_[eE][uU][cC][lL][iI][dD][eE][aA][nN]|[pP][fF]_[oO][cC][tT][iI][lL][eE]|[pP][fF]_[cC][hH][eE][bB][yY][sS][hH][eE][vV])\\b"
        }
      ]
    },
    "process-variables": {
      "patterns": [
        {
          "name": "variable.language.process.bennugd2",
          "match": "\\b([iI][dD]|[fF][aA][tT][hH][eE][rR]|[sS][oO][nN]|[bB][rR][oO][tT][hH][eE][rR]|[cC][aA][lL][lL][eE][rR]|[xX]|[yY]|[zZ]|[fF][iI][lL][eE]|[gG][rR][aA][pP][hH]|[sS][iI][zZ][eE]|[sS][iI][zZ][eE]_[xX]|[sS][iI][zZ][eE]_[yY]|[aA][nN][gG][lL][eE]|[fF][lL][aA][gG][sS]|[rR][eE][gG][iI][oO][nN]|[rR][eE][sS][oO][lL][uU][tT][iI][oO][nN]|[aA][lL][pP][hH][aA]|[cC][oO][lL][oO][rR]_[rR]|[cC][oO][lL][oO][rR]_[gG]|[cC][oO][lL][oO][rR]_[bB]|[cC][lL][iI][pP]|[cC][eE][nN][tT][eE][rR]|[cC][tT][yY][pP][eE]|[cC][nN][uU][mM][bB][eE][rR]|[xX][gG][rR][aA][pP][hH]|[rR][eE][nN][dD][eE][rR]_[fF][iI][lL][eE]|[rR][eE][nN][dD][eE][rR]_[gG][rR][aA][pP][hH]|[bB][lL][eE][nN][dD][mM][oO][dD][eE]|[cC][uU][sS][tT][oO][mM]_[bB][lL][eE][nN][dD][mM][oO][dD][eE]|[sS][hH][aA][dD][eE][rR]|[sS][hH][aA][dD][eE][rR]_[pP][aA][rR][aA][mM][sS]|[sS][mM][aA][lL][lL]_[bB][lL][oO][cC][kK]|[pP][rR][iI][oO][rR][iI][tT][yY])\\b"
        }
      ]
    },
    "builtin-functions": {
      "patterns": [
        {
