{
  "name": "BennuIDE Dark (One Dark Pro)",
  "type": "dark",
  "colors": {
    "activityBar.background": "#16161e",
    "activityBar.foreground": "#d7dae0",
    "activityBar.activeBorder": "#61afef",
    "activityBarBadge.background": "#61afef",
    "activityBarBadge.foreground": "#16161e",
    "badge.background": "#61afef",
    "badge.foreground": "#16161e",
    "button.background": "#61afef",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#5294cb",
    "editor.background": "#1a1b26",
    "editor.foreground": "#abb2bf",
    "editor.lineHighlightBackground": "#1e202e",
    "editor.selectionBackground": "#283457",
    "editorCursor.foreground": "#528bff",
    "editorGroupHeader.tabsBackground": "#16161e",
    "editorIndentGuide.activeBackground": "#5c6370",
    "editorIndentGuide.background": "#2e3240",
    "editorLineNumber.activeForeground": "#c678dd",
    "editorLineNumber.foreground": "#495162",
    "sideBar.background": "#16161e",
    "sideBar.foreground": "#abb2bf",
    "sideBarSectionHeader.background": "#1a1b26",
    "sideBarTitle.foreground": "#abb2bf",
    "statusBar.background": "#16161e",
    "statusBar.foreground": "#9da5b4",
    "statusBar.noFolderBackground": "#16161e",
    "statusBar.debuggingBackground": "#e06c75",
    "statusBar.debuggingForeground": "#ffffff",
    "tab.activeBackground": "#1a1b26",
    "tab.activeForeground": "#d7dae0",
    "tab.activeBorder": "#61afef",
    "tab.inactiveBackground": "#16161e",
    "tab.inactiveForeground": "#7f848e",
    "terminal.background": "#1a1b26",
    "terminal.foreground": "#abb2bf",
    "titleBar.activeBackground": "#16161e",
    "titleBar.activeForeground": "#9da5b4",
    "titleBar.inactiveBackground": "#16161e",
    "titleBar.inactiveForeground": "#6b717d"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "comment.line",
        "comment.block"
      ],
      "settings": {
        "foreground": "#5c6370",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#98c379"
      }
    },
    {
      "name": "Escape Characters",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#56b6c2"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#d19a66"
      }
    },
    {
      "name": "Keywords and Declarations",
      "scope": [
        "keyword.declaration",
        "keyword.control.block",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.flow"
      ],
      "settings": {
        "foreground": "#c678dd"
      }
    },
    {
      "name": "Process Control Keywords",
      "scope": [
        "keyword.control.process"
      ],
      "settings": {
        "foreground": "#e06c75",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Storage Types",
      "scope": [
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#e5c07b"
      }
    },
    {
      "name": "Language Constants and Signals",
      "scope": [
        "constant.language",
        "constant.other.signal",
        "constant.other.enum"
      ],
      "settings": {
        "foreground": "#56b6c2"
      }
    },
    {
      "name": "Process Language Variables",
      "scope": [
        "variable.language.process"
      ],
      "settings": {
        "foreground": "#e06c75"
      }
    },
    {
      "name": "Functions & Built-ins",
      "scope": [
        "support.function.builtin",
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#61afef"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#56b6c2"
      }
    },
    {
      "name": "Preprocessor Directives",
      "scope": [
        "keyword.control.directive",
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#c678dd",
        "fontStyle": "italic"
      }
    }
  ]
}
