{
  "name": "BennuIDE Light (PowerShell ISE)",
  "type": "light",
  "colors": {
    "activityBar.background": "#f0f0f0",
    "activityBar.foreground": "#333333",
    "activityBar.activeBorder": "#0055aa",
    "activityBarBadge.background": "#0055aa",
    "activityBarBadge.foreground": "#ffffff",
    "badge.background": "#0055aa",
    "badge.foreground": "#ffffff",
    "button.background": "#0055aa",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#004080",
    "editor.background": "#ffffff",
    "editor.foreground": "#000000",
    "editor.lineHighlightBackground": "#f5f5f5",
    "editor.selectionBackground": "#add6ff",
    "editorCursor.foreground": "#000000",
    "editorGroupHeader.tabsBackground": "#f0f0f0",
    "editorIndentGuide.activeBackground": "#939393",
    "editorIndentGuide.background": "#e0e0e0",
    "editorLineNumber.activeForeground": "#0055aa",
    "editorLineNumber.foreground": "#888888",
    "sideBar.background": "#f7f7f7",
    "sideBar.foreground": "#333333",
    "sideBarSectionHeader.background": "#e8e8e8",
    "sideBarTitle.foreground": "#333333",
    "statusBar.background": "#0055aa",
    "statusBar.foreground": "#ffffff",
    "statusBar.noFolderBackground": "#0055aa",
    "statusBar.debuggingBackground": "#cc3300",
    "statusBar.debuggingForeground": "#ffffff",
    "tab.activeBackground": "#ffffff",
    "tab.activeForeground": "#000000",
    "tab.activeBorder": "#0055aa",
    "tab.inactiveBackground": "#e8e8e8",
    "tab.inactiveForeground": "#666666",
    "terminal.background": "#012456",
    "terminal.foreground": "#ffffff",
    "titleBar.activeBackground": "#f0f0f0",
    "titleBar.activeForeground": "#333333",
    "titleBar.inactiveBackground": "#f0f0f0",
    "titleBar.inactiveForeground": "#888888"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "comment.line",
        "comment.block"
      ],
      "settings": {
        "foreground": "#008000",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#800000"
      }
    },
    {
      "name": "Escape Characters",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#a31515"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#000080"
      }
    },
    {
      "name": "Keywords and Declarations",
      "scope": [
        "keyword.declaration",
        "keyword.control.block",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.flow"
      ],
      "settings": {
        "foreground": "#0000ff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Process Control Keywords",
      "scope": [
        "keyword.control.process"
      ],
      "settings": {
        "foreground": "#800080",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Storage Types",
      "scope": [
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#2b91af"
      }
    },
    {
      "name": "Language Constants and Signals",
      "scope": [
        "constant.language",
        "constant.other.signal",
        "constant.other.enum"
      ],
      "settings": {
        "foreground": "#800080"
      }
    },
    {
      "name": "Process Language Variables",
      "scope": [
        "variable.language.process"
      ],
      "settings": {
        "foreground": "#7a3e9d"
      }
    },
    {
      "name": "Functions & Built-ins",
      "scope": [
        "support.function.builtin",
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#000080"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "name": "Preprocessor Directives",
      "scope": [
        "keyword.control.directive",
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#000080",
        "fontStyle": "bold"
      }
    }
  ]
}
