{
  "name": "bennuide-ai-agent",
  "displayName": "BennuIDE AI Coding Agent",
  "description": "Integrated AI assistant for BennuGD2 game development in BennuIDE.",
  "version": "1.0.0",
  "publisher": "vscode",
  "license": "MIT",
  "engines": {
    "vscode": "*"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:bennuide.aiChatView",
    "*"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bennuide-ai-view",
          "title": "BennuIDE AI Agent",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "bennuide-ai-view": [
        {
          "type": "webview",
          "id": "bennuide.aiChatView",
          "name": "BennuGD2 AI Assistant"
        }
      ]
    },
    "commands": [
      {
        "command": "bennuide.explainError",
        "title": "BennuIDE AI: Explicar Error de Compilación",
        "category": "BennuIDE AI"
      },
      {
        "command": "bennuide.scaffoldGame",
        "title": "BennuIDE AI: Generar Esqueleto de Videojuego",
        "category": "BennuIDE AI"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
